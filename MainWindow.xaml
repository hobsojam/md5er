<Window x:Class="md5er.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="md5er" Height="330" Width="700"
        Icon="pack://application:,,,/md5er.ico"
        ResizeMode="CanMinimize"
        Background="#1E1E1E" Foreground="#D4D4D4"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HashLabel" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="#888888"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"            Value="64"/>
        </Style>
        <Style x:Key="HashValue" TargetType="TextBox">
            <Setter Property="FontFamily"       Value="Consolas"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="IsReadOnly"       Value="True"/>
            <Setter Property="Background"       Value="#2D2D2D"/>
            <Setter Property="Foreground"       Value="#D4D4D4"/>
            <Setter Property="BorderBrush"      Value="#3C3C3C"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Width"            Value="52"/>
            <Setter Property="Height"           Value="26"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Background"       Value="#3C3C3C"/>
            <Setter Property="Foreground"       Value="#D4D4D4"/>
            <Setter Property="BorderBrush"      Value="#555555"/>
            <Setter Property="Cursor"           Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drop zone -->
        <Border Grid.Row="0"
                BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- Drop hint -->
                <TextBlock Text="Drop a file here"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#555555" FontSize="13"
                           Visibility="{Binding ShowDropHint, Converter={StaticResource BoolToVis}}"/>

                <!-- File name + busy indicator -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FileName}" FontSize="13" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="12,0,0,0"
                                 Foreground="#569CD6"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hash results -->
        <Grid Grid.Row="2"
              Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="MD5"    Style="{StaticResource HashLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="SHA-1"  Style="{StaticResource HashLabel}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256" Style="{StaticResource HashLabel}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="SHA-512" Style="{StaticResource HashLabel}"/>

            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MD5,    Mode=OneWay}" Style="{StaticResource HashValue}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SHA1,   Mode=OneWay}" Style="{StaticResource HashValue}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SHA256, Mode=OneWay}" Style="{StaticResource HashValue}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SHA512, Mode=OneWay}" Style="{StaticResource HashValue}"/>

            <Button Grid.Row="0" Grid.Column="2" Content="Copy" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Tag="{Binding MD5}"    Click="Copy_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Copy" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Tag="{Binding SHA1}"   Click="Copy_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Copy" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Tag="{Binding SHA256}" Click="Copy_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="Copy" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Tag="{Binding SHA512}" Click="Copy_Click"/>
        </Grid>

        <!-- Error -->
        <TextBlock Grid.Row="3"
                   Text="{Binding Error}"
                   Foreground="#F48771"
                   FontSize="12"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
